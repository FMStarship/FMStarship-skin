{
  "$description": "FM Starship skin design tokens. Source of truth for skin/tokens.uss (run scripts/build-tokens.py) and for the Figma variables. Colours were measured from the Portal design; the grey text colours are lightened to meet WCAG AA on cards.",
  "colour": {
    "app-background": "#131313",
    "surface-topbar": "#161616",
    "surface-card": "#1d1d1d",
    "surface-chip": "#282828",
    "divider": "#272727",
    "divider-strong": "#2a2a2a",

    "text-primary": "#eeeeee",
    "text-secondary": "#8e8e90",
    "text-label": "#8e8e90",
    "nav-idle": "#8e8e90",

    "accent": "#5033ff",
    "on-accent": "#ffffff",

    "positive": "#00cb8a",
    "positive-badge": "#00d47a",
    "on-positive-badge": "#111111",
    "negative": "#d24d41",

    "own-club-row": "#173b3e",
    "own-club-tag": "#2b5455",
    "on-own-club-tag": "#c6eded",

    "today-marker": "#d2d2d5",
    "on-today-marker": "#26262a",

    "training-blue": "#275783",
    "on-training-blue": "#94c8fa",
    "training-teal": "#117187",
    "on-training-teal": "#81dbe8",
    "training-green": "#236966",

/* Generated by scripts/build-tokens.py from design/tokens.json. Don't edit by hand. */

:root {
    /* colour */
    --fms-colour-app-background: #131313;
    --fms-colour-surface-topbar: #161616;
    --fms-colour-surface-card: #1d1d1d;
    --fms-colour-surface-chip: #282828;
    --fms-colour-divider: #272727;
    --fms-colour-divider-strong: #2a2a2a;
    --fms-colour-text-primary: #eeeeee;
    --fms-colour-text-secondary: #8e8e90;
    --fms-colour-text-label: #8e8e90;
    --fms-colour-nav-idle: #8e8e90;
    --fms-colour-accent: #5033ff;
    --fms-colour-on-accent: #ffffff;
    --fms-colour-positive: #00cb8a;
    --fms-colour-positive-badge: #00d47a;
    --fms-colour-on-positive-badge: #111111;
    --fms-colour-negative: #d24d41;
    --fms-colour-own-club-row: #173b3e;
    --fms-colour-own-club-tag: #2b5455;
    --fms-colour-on-own-club-tag: #c6eded;
    --fms-colour-today-marker: #d2d2d5;
    --fms-colour-on-today-marker: #26262a;
    --fms-colour-training-blue: #275783;
    --fms-colour-on-training-blue: #94c8fa;
    --fms-colour-training-teal: #117187;
    --fms-colour-on-training-teal: #81dbe8;
    --fms-colour-training-green: #236966;
    --fms-colour-training-purple: #604194;

    /* radius */
    --fms-radius-card: 10px;
    --fms-radius-chip: 9px;

    /* space */
    --fms-space-gutter: 16px;
    --fms-space-topbar-height: 80px;

    /* font-family */
    --fms-font-family-display: "Libre Baskerville";
    --fms-font-family-body: "Inter";

    /* font-size */
    --fms-font-size-headline: 26px;
    --fms-font-size-card-title: 19px;
    --fms-font-size-body: 14px;
    --fms-font-size-body-small: 12px;
    --fms-font-size-label: 11px;
    --fms-font-size-micro: 10px;
}
